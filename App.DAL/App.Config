<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- 
      name: identificador que usa ConfigurationManager para encontrar esta cadena
      Server: nombre del servidor SQL (localhost = tu máquina local)
      Database: nombre exacto de la BD
      Integrated Security=True: usa el usuario de Windows, no necesito user/password
    -->

    <add name="RestauranteDB"
         connectionString="Server=localhost\SQLEXPRESS;Database=RestauranteDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient"/>
  </connectionStrings>
</configuration>